# Backend
AMR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AMR_ADDITIONAL_SOURCES=1
AMR_PUBMED_TIMEOUT=1
AMR_PUBMED_RETRIES=1
AMR_PUBMED_QUERY_VARIANTS=2
AMR_PUBMED_FETCH_COUNTS=1
AMR_PMC_ENRICHMENT_ENABLED=0
AMR_LLM_QUERY_ENABLED=0
# Optional NCBI identification and rate-limit settings
AMR_NCBI_EMAIL=
AMR_NCBI_API_KEY=
# Optional Semantic Scholar access; never commit a real key
AMR_SEMANTIC_SCHOLAR_API_KEY=
# Optional local synthesis model
AMR_OLLAMA_URL=http://localhost:11434/api/generate
AMR_OLLAMA_MODEL=llama3.2:latest

# Frontend: create frontend/.env.local with this value
VITE_API_URL=http://localhost:5000
